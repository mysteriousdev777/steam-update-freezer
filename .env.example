# Optional: Aptabase analytics key (only used in the official build for telemetry).
# The app works perfectly fine without it; leave it empty or undefined for local development.
APTABASE_APP_KEY=

# GitHub Personal Access Token (repo scope) — used only by `pnpm run publish` to upload
# build artifacts to a draft GitHub release. Not needed for local development or `make`.
GITHUB_TOKEN=
