{
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "bracketSameLine": false,
  "bracketSpacing": true,
  "arrowParens": "avoid",
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrder": [
    "^react$",
    "^react-dom",
    "^electron$",
    "^electron-",
    "",
    "<BUILTIN_MODULES>",
    "",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@/shared/types",
    "",
    "^@/shared(/.*)?$",
    "",
    "^@/main/services(/.*)?$",
    "",
    "^@/main(/.*)?$",
    "",
    "^@/preload(/.*)?$",
    "",
    "^@/renderer/components(/.*)?$",
    "",
    "^@/renderer/hooks(/.*)?$",
    "",
    "^@/renderer/lib(/.*)?$",
    "",
    "^@/renderer(/.*)?$",
    "",
    "^@/",
    "",
    "^[./]",
    "",
    "^.+\\.css$"
  ],
  "importOrderParserPlugins": ["typescript", "jsx"]
}
